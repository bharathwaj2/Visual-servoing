<?xml version='1.0'?>
<sdf version='1.7'>
  <model name='cube_with_marker'>
    <!-- Cube (collision + visual) -->
    <link name='cube_link'>
      <pose>0 0 0 0 0 0</pose>
      <!-- <gravity>0</gravity> -->
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.166667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.166667</iyy>
          <iyz>0</iyz>
          <izz>0.166667</izz>
        </inertia>
      </inertial>
      <visual name='cube_visual'>
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <lighting>1</lighting>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
          <ambient>1 0 0 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <collision name='cube_collision'>
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Aruco Marker (visual only) -->
    <link name='aruco_marker_link'>
      <!-- Position: top face of cube (half cube height) + half marker thickness --> 
      <pose>0 0 0.025005 0 0 0</pose>
      <visual name='marker_visual'>
        <geometry>
          <box>
            <!-- Scale marker to match cube's top face -->
            <size>0.05 0.05 1e-5</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_marker/materials/scripts</uri>
            <uri>model://aruco_marker/materials/textures</uri>
            <name>ArucoMarker/Marker</name>
          </script>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <emissive>1 1 1 0</emissive>
        </material>
      </visual>
    </link>

    <!-- Fixed joint to attach marker to cube -->
    <joint name='marker_joint' type='fixed'>
      <parent>cube_link</parent>
      <child>aruco_marker_link</child>
    </joint>
  </model>
</sdf>
