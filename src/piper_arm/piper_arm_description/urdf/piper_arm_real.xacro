<?xml version="1.0"?>
<!-- OpenManipulator Chain -->
<robot name="piper" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="" />

  <!-- Launch this for PBVS with real Eye-in-Hand camera -->
  <xacro:include filename="$(find piper_arm_description)/urdf/piper_arm.xacro" />
  <xacro:piper_arm_ETH prefix="$(arg prefix)" />

</robot>
