<?xml version="1.0" encoding="utf-8"?>
<robot name="cube_with_marker">
  
  <!-- Cube Link -->
  <link name="cube_link">
    <inertial>
      <mass value="1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.166667" ixy="0" ixz="0" 
               iyy="0.166667" iyz="0" izz="0.166667"/>
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
  </link>
  
  <!-- ArUco Marker Link -->
  <link name="aruco_marker_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.0001"/>
      </geometry>
      <material name="ArucoMarker/Marker">
        <color rgba="1 1 1 1"/>
        <!-- You'll need to specify texture file path -->
        <texture filename="package://piper_arm_description/models/aruco_marker/materials/textures/aruco_marker_tex.png"/>
      </material>
    </visual>
  </link>
  
  <!-- Fixed Joint connecting marker to cube top -->
  <joint name="marker_joint" type="fixed">
    <parent link="cube_link"/>
    <child link="aruco_marker_link"/>
    <origin xyz="0 0 0.025005" rpy="0 0 0"/>
  </joint>
  
</robot>